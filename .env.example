# Copy to .env and change the values.  (LEGACY: secrets in a plain file on the server.)

SECRET_KEY=change-me-to-a-long-random-string

POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docflow

DATABASE_URL=postgresql+psycopg://docflow:change-me@postgres:5432/docflow
REDIS_URL=redis://redis:6379/0
GOTENBERG_URL=http://gotenberg:3000
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=20

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
